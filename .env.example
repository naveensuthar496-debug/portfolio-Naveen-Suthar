# ─────────────────────────────────────────────────────────
#  Copy this file to  .env  and fill in the real values.
#  .env is gitignored — never commit it.
# ─────────────────────────────────────────────────────────

# Port the site + API listen on
PORT=3000
NODE_ENV=development

# ── SSL/TLS (HTTPS) ──────────────────────────────────────
# Enable HTTPS: set to "true" to use SSL certificates
USE_HTTPS=false
# For custom certificate paths (optional):
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
# To generate self-signed certs for development: npm run gen:certs

# ── MongoDB ──────────────────────────────────────────────
# Atlas (free tier):  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Local mongod:       mongodb://127.0.0.1:27017
# URL-encode special characters in the password (@ = %40, # = %23, : = %3A).
MONGODB_URI=
MONGODB_DB=portfolio

# ── Azure SQL Database ───────────────────────────────────
# Set DATABASE_TYPE=mssql to use Azure SQL instead of MongoDB
# DATABASE_TYPE=mongodb|mssql (default: mongodb)
# DATABASE_TYPE=mssql
# AZURE_SQL_SERVER=your-server.database.windows.net
# AZURE_SQL_DATABASE=portfolio
# AZURE_SQL_USER=youradmin
# AZURE_SQL_PASSWORD=YourSecurePassword123!
# AZURE_SQL_PORT=1433

# ── Where enquiries are delivered ────────────────────────
MAIL_TO=naveensuthar496@gmail.com

# ── SMTP ─────────────────────────────────────────────────
# Gmail: leave MAIL_SERVICE=gmail, set SMTP_USER to your Gmail address and
# SMTP_PASS to a 16-character App Password (NOT your account password):
#   1. myaccount.google.com/security  → enable 2-Step Verification
#   2. myaccount.google.com/apppasswords → create one for "Mail"
MAIL_SERVICE=gmail
SMTP_USER=naveensuthar496@gmail.com
SMTP_PASS=

# Any other provider instead of Gmail — clear MAIL_SERVICE and use these:
# MAIL_SERVICE=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Shown as the From address. Gmail requires this to be SMTP_USER.
MAIL_FROM=naveensuthar496@gmail.com

# Send the visitor a "thanks, I got it" confirmation
MAIL_AUTOREPLY=true

# ── Retry algorithm ──────────────────────────────────────
MAIL_MAX_ATTEMPTS=5        # 5 tries: immediate, +1m, +2m, +4m, +8m
MAIL_RETRY_BASE_MS=60000   # first backoff, doubles each attempt
MAIL_SWEEP_MS=120000       # background catch-up interval

# ── Abuse protection ─────────────────────────────────────
RATE_WINDOW_MS=900000      # 15 minutes
RATE_MAX=5                 # submissions per IP per window
